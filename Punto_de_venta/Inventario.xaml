<Window
    x:Class="Punto_de_venta.InventarioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Punto_de_venta"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PosPia.Modelos"
    mc:Ignorable="d"
    Title="Ricos Jochos - Inventario"
    xmlns:converters="using:PosPia">

    <Grid Background="#FFF8EC" Padding="0" Loaded="RootGrid_Loaded" x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#43262B"/>
                <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#43262B"/>
                <converters:StringFormatConverter x:Key="StringFormatConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#43262B" BorderBrush="#FFC93C" BorderThickness="0,0,0,4" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo_jochos.png" Height="52" Stretch="Uniform"/>
                    <TextBlock Text="Inventario (ingredientes)" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Volver"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="16,8" Click="OnRegresarClick"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Background="#FFFFFF" BorderBrush="#E8C99A" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="MateriaPrimaGrid"
                      SelectionMode="Single"
                      SelectionChanged="MateriaPrimaGrid_SelectionChanged"
                      Background="Transparent"
                      Foreground="#43262B">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="#43262B"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Header>
                    <Grid Background="#FDF0D5" Padding="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Grid.Column="0" FontWeight="Bold"/>
                        <TextBlock Text="Insumo" Grid.Column="1" FontWeight="Bold"/>
                        <TextBlock Text="Unidad" Grid.Column="2" FontWeight="Bold"/>
                        <TextBlock Text="Existencia" Grid.Column="3" FontWeight="Bold"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Ingrediente">
                        <Grid Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind IdIngrediente}" Grid.Column="0" VerticalAlignment="Center" Foreground="#D62828"/>
                            <TextBlock Text="{x:Bind Nombre}" Grid.Column="1" Foreground="#43262B" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind UnidadMedida}" Grid.Column="2" VerticalAlignment="Center" Foreground="#43262B"/>
                            <TextBlock Text="{Binding Stock, Converter={StaticResource StringFormatConverter}, ConverterParameter='N5'}"
                                       Grid.Column="3" Foreground="#D62828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#F1DDBB" BorderThickness="0,1,0,0" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="TxtNombre" PlaceholderText="Nombre del ingrediente" Width="200"
                         Background="#FFF8EC" Foreground="#43262B" BorderBrush="#E0B377"
                         BeforeTextChanging="TxtNombre_BeforeTextChanging"/>
                <ComboBox x:Name="CmbUnidad" PlaceholderText="Unidad" Width="110"
                          Background="#FFF8EC" Foreground="#43262B">
                    <x:String>kg</x:String>
                    <x:String>g</x:String>
                    <x:String>lt</x:String>
                    <x:String>ml</x:String>
                    <x:String>pz</x:String>
                </ComboBox>
                <TextBox x:Name="TxtStock" PlaceholderText="Stock" InputScope="Number" Width="110"
                         Background="#FFF8EC" Foreground="#43262B" BorderBrush="#E0B377"
                         BeforeTextChanging="TxtStock_BeforeTextChanging"/>
                <Button Content="Alta" Style="{StaticResource AccentButtonStyle}" Click="OnAgregarClick"/>
                <Button Content="Editar" Background="#FFFFFF" Foreground="#43262B" BorderBrush="#D62828" BorderThickness="1" Click="OnModificarClick"/>
                <Button Content="Baja" Background="Transparent" Foreground="#C0392B" BorderBrush="#C0392B" BorderThickness="1" Click="OnEliminarClick"/>
                <Button Content="Limpiar campos" Background="#FDF0D5" Foreground="#43262B" BorderThickness="0" Click="OnLimpiarClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
