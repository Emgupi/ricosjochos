<Window
    x:Class="Punto_de_venta.InventarioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Punto_de_venta"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PosPia.Modelos"
    mc:Ignorable="d"
    Title="Ricos Jochos - Inventario"
    xmlns:converters="using:PosPia">

    <Grid Background="#F4F8FA" Padding="0" Loaded="RootGrid_Loaded" x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#12344D"/>
                <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#12344D"/>
                <converters:StringFormatConverter x:Key="StringFormatConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12344D" Padding="20,0">
            <Grid>
                <TextBlock Text="Inventario (ingredientes)" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Content="Volver"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="16,8" Click="OnRegresarClick"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Background="#FFFFFF" BorderBrush="#B8D0DA" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="MateriaPrimaGrid"
                      SelectionMode="Single"
                      SelectionChanged="MateriaPrimaGrid_SelectionChanged"
                      Background="Transparent"
                      Foreground="#12344D">
                <ListView.Header>
                    <Grid Background="#E8F1F5" Padding="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Grid.Column="0" FontWeight="Bold"/>
                        <TextBlock Text="Insumo" Grid.Column="1" FontWeight="Bold"/>
                        <TextBlock Text="Unidad" Grid.Column="2" FontWeight="Bold"/>
                        <TextBlock Text="Existencia" Grid.Column="3" FontWeight="Bold"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Ingrediente">
                        <Grid Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind IdIngrediente}" Grid.Column="0" Foreground="#0E7C86"/>
                            <TextBlock Text="{x:Bind Nombre}" Grid.Column="1"/>
                            <TextBlock Text="{x:Bind UnidadMedida}" Grid.Column="2"/>
                            <TextBlock Text="{Binding Stock, Converter={StaticResource StringFormatConverter}, ConverterParameter='N5'}"
                                       Grid.Column="3" Foreground="#0E7C86" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D0E0E6" BorderThickness="0,1,0,0" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="TxtNombre" PlaceholderText="Nombre del ingrediente" Width="200"
                         Background="#F4F8FA" Foreground="#12344D" BorderBrush="#8FB4C2"
                         BeforeTextChanging="TxtNombre_BeforeTextChanging"/>
                <ComboBox x:Name="CmbUnidad" PlaceholderText="Unidad" Width="110"
                          Background="#F4F8FA" Foreground="#12344D">
                    <x:String>kg</x:String>
                    <x:String>g</x:String>
                    <x:String>lt</x:String>
                    <x:String>ml</x:String>
                    <x:String>pz</x:String>
                </ComboBox>
                <TextBox x:Name="TxtStock" PlaceholderText="Stock" InputScope="Number" Width="110"
                         Background="#F4F8FA" Foreground="#12344D" BorderBrush="#8FB4C2"
                         BeforeTextChanging="TxtStock_BeforeTextChanging"/>
                <Button Content="Alta" Style="{StaticResource AccentButtonStyle}" Click="OnAgregarClick"/>
                <Button Content="Editar" Background="#FFFFFF" Foreground="#12344D" BorderBrush="#0E7C86" BorderThickness="1" Click="OnModificarClick"/>
                <Button Content="Baja" Background="Transparent" Foreground="#C0392B" BorderBrush="#C0392B" BorderThickness="1" Click="OnEliminarClick"/>
                <Button Content="Limpiar campos" Background="#E8F1F5" Foreground="#12344D" BorderThickness="0" Click="OnLimpiarClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
