<Window
    x:Class="Punto_de_venta.Menu_principal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ricos Jochos — Panel">

    <Grid Background="#F4F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12344D" Padding="24,0">
            <Grid>
                <TextBlock Text="RICOS JOCHOS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="RoleTextBlock"
                           FontSize="14"
                           Foreground="#9ED8DE"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Width="320">

                <TextBlock Text="¿Qué deseas hacer?"
                           FontSize="16"
                           Foreground="#5A7A8A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Button x:Name="VentaButton"
                        Content="Abrir caja / Venta"
                        Height="48"
                        Background="#0E7C86"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnRealizarVentaClick"/>

                <Button x:Name="InventarioButton"
                        Content="Inventario de ingredientes"
                        Height="48"
                        Background="#FFFFFF"
                        Foreground="#12344D"
                        BorderBrush="#0E7C86"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnGestionInventarioClick"/>

                <Button x:Name="ClientesButton"
                        Content="Directorio de clientes"
                        Height="48"
                        Background="#FFFFFF"
                        Foreground="#12344D"
                        BorderBrush="#8FB4C2"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnCatalogoClientesClick"/>

                <Button x:Name="CerrarSesionButton"
                        Content="Cerrar sesión"
                        Height="44"
                        Background="Transparent"
                        Foreground="#C0392B"
                        FontWeight="SemiBold"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"
                        Click="OnCerrarSesionClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
