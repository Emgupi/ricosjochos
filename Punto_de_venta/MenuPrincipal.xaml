<Window
    x:Class="Punto_de_venta.Menu_principal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ricos Jochos - Panel">

    <Grid Background="#FFF8EC">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#43262B" BorderBrush="#FFC93C" BorderThickness="0,0,0,4" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo_jochos.png" Height="60" Stretch="Uniform"/>
                    <TextBlock Text="RICOS JOCHOS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="RoleTextBlock"
                           FontSize="14"
                           Foreground="#FFC93C"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Width="320">

                <Image Source="ms-appx:///Assets/logo_jochos.png"
                       Height="150"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                <TextBlock Text="¿Qué deseas hacer?"
                           FontSize="16"
                           Foreground="#8A6355"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Button x:Name="AperturaButton"
                        Content="Apertura de caja"
                        Height="48"
                        Background="#FFFFFF"
                        Foreground="#43262B"
                        BorderBrush="#D62828"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnAperturaCajaClick"/>

                <Button x:Name="VentaButton"
                        Content="Ir a venta"
                        Height="48"
                        Style="{StaticResource AccentButtonStyle}"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnRealizarVentaClick"/>

                <Button x:Name="InventarioButton"
                        Content="Inventario de ingredientes"
                        Height="48"
                        Background="#FFFFFF"
                        Foreground="#43262B"
                        BorderBrush="#D62828"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnGestionInventarioClick"/>

                <Button x:Name="ClientesButton"
                        Content="Directorio de clientes"
                        Height="48"
                        Background="#FFFFFF"
                        Foreground="#43262B"
                        BorderBrush="#E0B377"
                        BorderThickness="1.5"
                        FontWeight="SemiBold"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Click="OnCatalogoClientesClick"/>

                <Button x:Name="CerrarSesionButton"
                        Content="Cerrar sesión"
                        Height="44"
                        Background="Transparent"
                        Foreground="#C0392B"
                        FontWeight="SemiBold"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"
                        Click="OnCerrarSesionClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
