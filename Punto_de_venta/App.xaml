<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Punto_de_venta.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Punto_de_venta"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Texto legible en TextBox/PasswordBox (normal, hover y focus) -->
            <SolidColorBrush x:Key="TextControlForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#43262B"/>
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFF8EC"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FDF0D5"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E0B377"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D62828"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D62828"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A6355"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A6355"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#E0B377"/>
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#43262B"/>

            <SolidColorBrush x:Key="ComboBoxForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#43262B"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#43262B"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFF8EC"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FDF0D5"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FDF0D5"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#8A6355"/>
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="#8A6355"/>
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="#8A6355"/>

            <!-- Botones normales: texto oscuro también en hover/pressed -->
            <SolidColorBrush x:Key="ButtonForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#43262B"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#E0B377"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FDF0D5"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FBE3A6"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFF8EC"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E0B377"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D62828"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D62828"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#F1DDBB"/>

            <!-- Botones de acento (rojo cátsup): texto blanco en todos los estados -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#D62828"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B71F1F"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8F1818"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#F0A8A8"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FFF8EC"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#D62828"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#B71F1F"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#8F1818"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#F0A8A8"/>

            <!-- Listas: texto oscuro en normal, hover, presionado y seleccionado -->
            <SolidColorBrush x:Key="ListViewItemForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundPressed" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#43262B"/>
            <SolidColorBrush x:Key="ListViewItemBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FDF0D5"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#FBE3A6"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FBE3A6"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FBE3A6"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FBE3A6"/>

            <SolidColorBrush x:Key="GridViewItemForeground" Color="#43262B"/>
            <SolidColorBrush x:Key="GridViewItemForegroundPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="GridViewItemForegroundPressed" Color="#43262B"/>
            <SolidColorBrush x:Key="GridViewItemForegroundSelected" Color="#43262B"/>
            <SolidColorBrush x:Key="GridViewItemForegroundSelectedPointerOver" Color="#43262B"/>
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>


