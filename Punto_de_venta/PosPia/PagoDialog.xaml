<ContentDialog
    x:Class="PosPia.PagoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PosPia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Cobro"
    PrimaryButtonText="Confirmar"
    SecondaryButtonText="Cancelar"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Background="#FFFFFF"
    Foreground="#12344D"
    BorderBrush="#0E7C86"
    BorderThickness="1">

    <ContentDialog.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4F8FA"/>
            <Setter Property="Foreground" Value="#12344D"/>
            <Setter Property="BorderBrush" Value="#8FB4C2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#12344D"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#12344D"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F4F8FA"/>
            <Setter Property="Foreground" Value="#12344D"/>
            <Setter Property="BorderBrush" Value="#8FB4C2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="14">
        <Border Background="#E8F1F5" Padding="12" CornerRadius="2">
            <Grid>
                <TextBlock Text="Importe a cobrar" FontSize="14" Foreground="#5A7A8A"/>
                <TextBlock x:Name="TotalPagarTextBlock" Text="$0.00"
                           FontSize="26" FontWeight="Bold" Foreground="#0E7C86"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <TextBlock Text="Forma de pago" FontWeight="SemiBold"/>

        <RadioButtons x:Name="MetodoPagoRadioButtons"
                      SelectedIndex="0"
                      SelectionChanged="MetodoPago_SelectionChanged">
            <RadioButton Content="Efectivo"/>
            <RadioButton Content="Transferencia"/>
        </RadioButtons>

        <StackPanel x:Name="EfectivoPanel" Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Monto recibido" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="EfectivoRecibidoTextBox"
                         PlaceholderText="0.00"
                         TextChanged="EfectivoRecibido_TextChanged"/>
            </Grid>
            <Grid>
                <TextBlock Text="Cambio" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="CambioTextBlock" Text="$0.00" FontSize="16" FontWeight="Bold"
                           Foreground="#0E7C86" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</ContentDialog>
