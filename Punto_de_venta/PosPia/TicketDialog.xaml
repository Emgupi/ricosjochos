<ContentDialog
    x:Class="PosPia.TicketDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PosPia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PosPia.Modelos"
    mc:Ignorable="d"
    Title="Resumen de venta"
    PrimaryButtonText="Imprimir"
    CloseButtonText="Cerrar"
    Background="#FFFFFF"
    Foreground="#12344D"
    BorderBrush="#0E7C86"
    BorderThickness="1">

    <ContentDialog.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#12344D"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4F8FA"/>
            <Setter Property="Foreground" Value="#12344D"/>
            <Setter Property="BorderBrush" Value="#8FB4C2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#F4F8FA"/>
            <Setter Property="Foreground" Value="#12344D"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#12344D"/>
            <Setter Property="BorderBrush" Value="#D0E0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <local:StringFormatConverter x:Key="StringFormatConverter"/>
    </ContentDialog.Resources>

    <Grid MinWidth="360" MaxHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" x:Name="ItemsListView">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modelos:CarritoItem">
                    <Grid HorizontalAlignment="Stretch" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold">
                            <Run Text="{Binding Cantidad}"/>
                            <Run Text="×"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Nombre}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subtotal, ConverterParameter='C2', Converter={StaticResource StringFormatConverter}}"
                                   HorizontalAlignment="Right"
                                   Foreground="#0E7C86"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Margin="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="#D0E0E6" Padding="0,12,0,0">
            <Grid>
                <TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TotalTicketTextBlock" Text="$0.00" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right" Foreground="#0E7C86"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
