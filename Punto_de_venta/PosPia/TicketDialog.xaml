<ContentDialog
    x:Class="PosPia.TicketDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PosPia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PosPia.Modelos"
    mc:Ignorable="d"
    Title="Resumen de venta"
    PrimaryButtonText="Imprimir"
    CloseButtonText="Cerrar"
    Background="#FFFFFF"
    Foreground="#43262B"
    BorderBrush="#D62828"
    BorderThickness="1"
    RequestedTheme="Light">

    <ContentDialog.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#43262B"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFF8EC"/>
            <Setter Property="Foreground" Value="#43262B"/>
            <Setter Property="BorderBrush" Value="#E0B377"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FFF8EC"/>
            <Setter Property="Foreground" Value="#43262B"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#43262B"/>
            <Setter Property="BorderBrush" Value="#F1DDBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <local:StringFormatConverter x:Key="StringFormatConverter"/>
    </ContentDialog.Resources>

    <Grid MinWidth="360" MaxHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" x:Name="ItemsListView">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modelos:CarritoItem">
                    <Grid HorizontalAlignment="Stretch" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#43262B">
                            <Run Text="{Binding Cantidad}"/>
                            <Run Text="×"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Nombre}" Foreground="#43262B"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subtotal, ConverterParameter='C2', Converter={StaticResource StringFormatConverter}}"
                                   HorizontalAlignment="Right"
                                   Foreground="#D62828"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Margin="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="#F1DDBB" Padding="0,12,0,0">
            <Grid>
                <TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TotalTicketTextBlock" Text="$0.00" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right" Foreground="#D62828"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
