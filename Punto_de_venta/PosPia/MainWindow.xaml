<Window
    x:Class="PosPia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PosPia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelos="using:PosPia.Modelos"
    mc:Ignorable="d"
    Title="Ricos Jochos - Venta">

    <Grid Background="#FFF8EC">
        <Grid.Resources>
            <local:StringFormatConverter x:Key="StringFormatConverter"/>
            <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>

            <Style x:Key="ProductoCardStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#43262B"/>
                <Setter Property="BorderBrush" Value="#E0B377"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#43262B"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="#43262B" BorderBrush="#FFC93C" BorderThickness="0,0,0,4" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Image Source="ms-appx:///Assets/logo_jochos.png" Height="52" Stretch="Uniform"/>
                    <TextBlock Text="RICOS JOCHOS" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#A87C6E" VerticalAlignment="Center"/>
                    <TextBlock Text="Caja / venta" Foreground="#FFC93C" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <Button x:Name="RegresarButton"
                        Content="Volver al panel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,8"
                        Click="RegresarButton_Click"/>
            </Grid>
        </Border>

        <!-- Categorías horizontales -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#F1DDBB" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Filtro:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button x:Name="TodosButton" Content="Todos" Padding="14,6" Click="TodosButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <ListView x:Name="CategoriasListView"
                          SelectionMode="Single"
                          ItemClick="CategoriasListView_ItemClick"
                          IsItemClickEnabled="True"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Padding="10,4" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Background" Value="#FDF0D5"/>
                            <Setter Property="Foreground" Value="#43262B"/>
                            <Setter Property="BorderBrush" Value="#E0B377"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="MinWidth" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Contenido: carrito izquierda + productos derecha -->
        <Grid Grid.Row="2" Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pedido (izquierda) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8C99A" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#D62828" Padding="14,12" CornerRadius="4,4,0,0">
                        <TextBlock Text="Pedido en curso" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="12,10,12,8" Orientation="Horizontal">
                        <TextBlock Text="Cliente:" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ClienteActualTextBlock" Text="Público General" Foreground="#8A6355"/>
                    </StackPanel>

                    <ListView Grid.Row="2" x:Name="CarritoListView" SelectionMode="None" Background="Transparent" Padding="8,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="modelos:CarritoItem">
                                <Border Background="#FFF8EC" BorderBrush="#F1DDBB" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,3">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtotal, ConverterParameter='C2', Converter={StaticResource StringFormatConverter}}"
                                                       Foreground="#D62828" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                            <Button Content="−" Width="30" Height="30" Click="BotonMenos_Click" DataContext="{Binding}"/>
                                            <TextBlock Text="{Binding Cantidad}" Width="28" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Button Content="+" Width="30" Height="30" Click="BotonMas_Click" DataContext="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3" Margin="12" BorderThickness="0,1,0,0" BorderBrush="#F1DDBB" Padding="0,12,0,0" Spacing="4">
                        <Grid>
                            <TextBlock Text="Subtotal"/>
                            <TextBlock x:Name="SubtotalTextBlock" Text="$0.00" HorizontalAlignment="Right" Foreground="#D62828"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="IVA (16%)"/>
                            <TextBlock x:Name="IVATextBlock" Text="$0.00" HorizontalAlignment="Right" Foreground="#D62828"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalTextBlock" Text="$0.00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#43262B"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="12,0,12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LimpiarButton" Content="Vaciar" HorizontalAlignment="Stretch" Click="BotonLimpiar_Click"/>
                        <Button x:Name="PagarButton" Content="Cobrar" Grid.Column="1" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BotonPagar_Click" IsEnabled="False"/>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="12,0,12,12" Spacing="6">
                        <Button x:Name="PedidoButton" Content="Elegir cliente" HorizontalAlignment="Stretch" Click="BotonPedido_Click"/>
                        <Button x:Name="CorteButton" Content="Corte del día" HorizontalAlignment="Stretch" Click="BotonCorte_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Productos (derecha) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,10" Spacing="2">
                    <TextBlock Text="Menú de jochos" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Catalogo preliminar" FontSize="12" Foreground="#8A6355"/>
                </StackPanel>

                <GridView Grid.Row="1"
                          x:Name="ProductosGridView"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ProductosGridView_ItemClick"
                          ItemContainerStyle="{StaticResource ProductoCardStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="modelos:Producto">
                            <Border MinHeight="110" MinWidth="170"
                                    Background="#FFFFFF"
                                    BorderBrush="#F1DDBB"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Opacity="{Binding EstaDisponible, Converter={StaticResource BoolToOpacityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#D62828" CornerRadius="4,0,0,4"/>
                                    <StackPanel Grid.Column="1" Padding="12" Spacing="4">
                                        <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="#8A6355" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Precio, ConverterParameter='C2', Converter={StaticResource StringFormatConverter}}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#D62828"
                                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Window>
