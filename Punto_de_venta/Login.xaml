<Window
    x:Class="Punto_de_venta.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ricos Jochos - Acceso">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDF0D5" Offset="0"/>
                <GradientStop Color="#FBE3A6" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Image Source="ms-appx:///Assets/logo_jochos.png"
                   Height="170"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>
            <TextBlock Text="Punto de venta - hot dogs"
                       FontSize="13"
                       Foreground="#8A6355"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                Padding="36,28"
                CornerRadius="4"
                HorizontalAlignment="Center"
                Width="380"
                BorderBrush="#E8C99A"
                BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock Text="Iniciar sesión"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#43262B"/>

                <TextBox x:Name="UsernameTextBox"
                         PlaceholderText="Usuario"
                         FontSize="15"
                         Padding="12,10"
                         Background="#FFF8EC"
                         Foreground="#43262B"
                         BorderBrush="#E0B377"
                         BorderThickness="1"
                         CornerRadius="2"/>

                <PasswordBox x:Name="PasswordBoxControl"
                             PlaceholderText="Contraseña"
                             FontSize="15"
                             Padding="12,10"
                             Background="#FFF8EC"
                             Foreground="#43262B"
                             BorderBrush="#E0B377"
                             BorderThickness="1"
                             CornerRadius="2"/>

                <Grid Margin="0,8,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Entrar"
                            Click="OnLoginClick"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            CornerRadius="2"/>

                    <Button Grid.Column="1"
                            Content="Salir"
                            Click="BtnSalir_Click"
                            Background="Transparent"
                            Foreground="#C0392B"
                            BorderBrush="#C0392B"
                            BorderThickness="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            CornerRadius="2"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
