<Window
    x:Class="Punto_de_venta.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ricos Jochos - Acceso">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8F1F5" Offset="0"/>
                <GradientStop Color="#D0E4EC" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="RICOS JOCHOS"
                       FontFamily="Segoe UI Semibold"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#12344D"
                       HorizontalAlignment="Center"
                       CharacterSpacing="100"/>
            <TextBlock Text="Punto de venta - hot dogs"
                       FontSize="13"
                       Foreground="#5A7A8A"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                Padding="36,28"
                CornerRadius="4"
                HorizontalAlignment="Center"
                Width="380"
                BorderBrush="#B8D0DA"
                BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock Text="Iniciar sesión"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#12344D"/>

                <TextBox x:Name="UsernameTextBox"
                         PlaceholderText="Usuario"
                         FontSize="15"
                         Padding="12,10"
                         Background="#F4F8FA"
                         Foreground="#12344D"
                         BorderBrush="#8FB4C2"
                         BorderThickness="1"
                         CornerRadius="2"/>

                <PasswordBox x:Name="PasswordBoxControl"
                             PlaceholderText="Contraseña"
                             FontSize="15"
                             Padding="12,10"
                             Background="#F4F8FA"
                             Foreground="#12344D"
                             BorderBrush="#8FB4C2"
                             BorderThickness="1"
                             CornerRadius="2"/>

                <Grid Margin="0,8,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Entrar"
                            Click="OnLoginClick"
                            Background="#0E7C86"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            CornerRadius="2"/>

                    <Button Grid.Column="1"
                            Content="Salir"
                            Click="BtnSalir_Click"
                            Background="Transparent"
                            Foreground="#C0392B"
                            BorderBrush="#C0392B"
                            BorderThickness="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            CornerRadius="2"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
